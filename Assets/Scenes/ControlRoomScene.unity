--- !u!114 &1037479258
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1037479256}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b031e8866e04b8441a56ee472768b03e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogue
  dialogueText: {fileID: 186348678}
  dialogueSets:
  - setName: Story_1
    lines:
    - "\u201CAlex, be careful. That creature is unlike anything we've faced before.\u201D"
    - "\u201CI saw it tear through an entire squad by itself.\u201D"
    - "\u201CKeep your distance and don't let it get close. Its strength is terrifying
      at close range.\u201D\u201CKeep your distance and don't let it get close. Its
      strength is terrifying at close range.\u201D"
    - "\u201CStay focused, keep moving, and you'll have a chance.\u201D"
    - "\u201CGood luck, Alex.\u201D"
  - setName: Story_2
    lines:
    - "\u201CCaptain... the Command Bridge is secure.\u201D"
    - "\u201CThe enemy forces are gone. The Mothership is ours again.\u201D"
    - "\u201CWe thought all hope was lost... but Alex proved us wrong.\u201D"
    - "\u201CThank you, Captain, for never giving up on us.\u201D"
    - "\u201CAnd thank you, Alex... for saving all of us.\u201D"
    - "\u201CToday, we didn't just reclaim a ship.\u201D"
    - "\u201CWe reclaimed our future.\u201D"

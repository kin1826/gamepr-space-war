--- !u!114 &1235585628
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1235585626}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: b031e8866e04b8441a56ee472768b03e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogue
  dialogueText: {fileID: 1906895976}
  dialogueSets:
  - setName: Story_1
    lines:
    - "\u201CAlex\u2026 ch\xFAng t\xF4i \u0111\xE3 c\u1ED1 g\u1EAFng h\u1EBFt s\u1EE9c
      \u0111\u1EC3 b\u1EA3o v\u1EC7 con t\xE0u\u2026 nh\u01B0ng b\u1ECDn ch\xFAng
      qu\xE1 m\u1EA1nh.\u201D"
    - "\u201CC\xE1c \u0111\u1ED9i chi\u1EBFn \u0111\u1EA5u \u0111\xE3 b\u1ECB ti\xEAu
      di\u1EC7t l\u1EA7n l\u01B0\u1EE3t. Ch\xFAng t\xF4i kh\xF4ng th\u1EC3 ng\u0103n
      \u0111\u01B0\u1EE3c ch\xFAng\u2026\u201D"
    - "\u201CB\u1ECDn T\xE0 Th\u1EA7n \u0111\xE3 chi\u1EBFm \u0111\u01B0\u1EE3c khu
      n\u0103ng l\u01B0\u1EE3ng. N\u1EBFu l\xF5i n\u0103ng l\u01B0\u1EE3ng b\u1ECB
      ph\xE1 h\u1EE7y, to\xE0n b\u1ED9 t\xE0u m\u1EB9 s\u1EBD s\u1EE5p \u0111\u1ED5.\u201D"
    - "\u201CAnh ph\u1EA3i t\u1EDBi \u0111\xF3\u2026 ti\xEAu di\u1EC7t ch\xFAng tr\u01B0\u1EDBc
      khi qu\xE1 mu\u1ED9n.\u201D"
    - "\u201CXin h\xE3y\u2026 c\u1EE9u l\u1EA5y con t\xE0u.\u201D"
  - setName: Story_2
    lines:
    - "\u201CL\u0169 binh l\xEDnh x\u01B0\u01A1ng \u0111ang canh g\xE1c xung quanh
      l\xF5i n\u0103ng l\u01B0\u1EE3ng t\u1EEB m\u1ECDi ph\xEDa.\u201D"
    - "\u201CCh\xFAng \u0111\xE3 bi\u1EBFn to\xE0n b\u1ED9 khu v\u1EF1c n\xE0y th\xE0nh
      m\u1ED9t ph\xE1o \u0111\xE0i ph\xF2ng th\u1EE7.\u201D"
    - "\u201CH\xE3y ti\xEAu di\u1EC7t m\u1ECDi th\u1EE9 c\u1EA3n \u0111\u01B0\u1EDDng,
      chi\u1EBFm l\u1EA1i l\xF5i n\u0103ng l\u01B0\u1EE3ng v\xE0 ti\u1EBFn \u0111\u1EBFn
      ph\xF2ng \u0111i\u1EC1u khi\u1EC3n.\u201D"
    - "\u201CM\u1ECDi ng\u01B0\u1EDDi \u0111ang tr\xF4ng c\u1EADy v\xE0o anh, Alex.\u201D"
    - "\u201CXin h\xE3y\u2026 c\u1EE9u l\u1EA5y con t\xE0u.\u201D"

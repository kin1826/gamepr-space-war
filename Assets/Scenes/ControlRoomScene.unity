  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogue
  dialogueText: {fileID: 506726351}
  dialogues:
  - "\u201CAlex, a few survivors are trapped inside the evacuation rooms near the
    engineering sector.\u201D"
  - "\u201CThe corridors are under enemy control, so clear the area and rescue the
    crew members.\u201D"
  - "\u201CGo save them. They\u2019ll be a great help to you.\u201D"
  - "\u201CGood luck.\u201D"

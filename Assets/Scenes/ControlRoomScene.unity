  m_Script: {fileID: 11500000, guid: b031e8866e04b8441a56ee472768b03e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::StoryDialogue
  dialogueText: {fileID: 1832905900}
  dialogueSets:
  - setName: Intro
    lines:
    - "\u201CAlex, you've made it to the Command Bridge.\u201D"
    - "\u201CThe enemy forces are retreating. They've realized they can no longer
      hold the ship.\u201D"
    - "\u201CBut don't let your guard down. Before fleeing, they activated their
      final contingency.\u201D"
    - "\u201CThe creature before you is their last weapon... the guardian of their
      invasion.\u201D"
    - "\u201CAs long as it lives, we cannot reclaim control of the Mothership.\u201D"
    - "\u201CDefeat it, Alex. End this once and for all.\u201D"
    - "\u201CBe careful... and good luck.\u201D"
